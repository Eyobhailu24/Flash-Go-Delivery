# Physical phones: replace this with your computer's LAN IP, e.g. http://192.168.1.20:3001
# Leave blank to infer the Expo development server's host. Android emulator fallback: 10.0.2.2.
EXPO_PUBLIC_API_URL=
# true: Google on Android, Apple on iOS. false: the website's Leaflet / OpenStreetMap map.
EXPO_PUBLIC_GOOGLE_MAPS=false
# Needed only for Google Maps Android development/release builds. Restrict to app + signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional: set an existing EAS project UUID to enable Expo remote push registration.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Android push: path to the matching Firebase client config, e.g. ./google-services.json.
GOOGLE_SERVICES_JSON_PATH=
# App identity; customize before creating signed builds.
APP_IDENTIFIER=com.flashgo.delivery
# Public routing and address-search endpoints; replace with your own endpoints as needed.
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
EXPO_PUBLIC_GEOCODING_URL=https://nominatim.openstreetmap.org
