NODE_ENV=production
PORT=3001

# Public app URLs
FRONTEND_URL=https://flash-go-delivery.up.railway.app
BACKEND_URL=https://your-backend-domain.example.com

# Backward-compatible aliases (optional)
# FRONTEND_ORIGIN=https://flash-go-delivery.up.railway.app
# BACKEND_BASE_URL=https://your-backend-domain.example.com

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth
JWT_SECRET=replace-me

# Telegram bot
TELEGRAM_BOT_TOKEN=replace-me

# Chapa payment
CHAPA_SECRET_KEY=replace-me
# Optional (defaults to https://api.chapa.co/v1)
# CHAPA_BASE_URL=https://api.chapa.co/v1
